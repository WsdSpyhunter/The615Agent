---
import { site } from '../site.config';
import data from '../../public/data/testimonials.json';
import summary from '../../public/data/reviews-summary.json';
const items = data.filter((t: any) => site.showPlaceholderTestimonials || !t.placeholder);
const hasPlaceholder = items.some((t: any) => t.placeholder);
---
{items.length > 0 && (
<section class="testi" id="reviews">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="kicker">Client reviews</span>
        <h2>What clients say</h2>
        <p>Real words from real buyers and sellers. {hasPlaceholder && <span class="sample">Placeholder cards</span>}</p>
        {summary.reviewCount > 0 && !hasPlaceholder && <p><b style="color:var(--gold)">★ {Number(summary.averageRating).toFixed(1)}</b> average from {summary.reviewCount} {summary.reviewCount === 1 ? 'review' : 'reviews'} on <a href={summary.profileUrl} target="_blank" rel="noopener" style="text-decoration:underline">Zillow</a></p>}
      </div>
      <a class="btn ghost sm" href="/reviews" style="color:#fff">See reviews</a>
    </div>
  </div>
  <div class="wrap" style="max-width:none;padding-inline:0">
    <tpa-testimonials src="/data/testimonials.json" show-placeholders={String(site.showPlaceholderTestimonials)}>
      <ul class="wrap" style="list-style:none">
        {items.slice(0, 3).map((t: any) => <li style="margin-bottom:10px">“{t.quote}” <b>{t.name}</b>, {t.detail}</li>)}
      </ul>
    </tpa-testimonials>
  </div>
</section>
)}
