---
import { site } from '../site.config';
---
<div class="signup">
  <div>
    <h2>The monthly market report</h2>
    <p>One short email each month with prices, days on market and inventory for the I-65 corridor. Unsubscribe any time.</p>
  </div>
  <div>
    <form class="row" action={`https://buttondown.com/api/emails/embed-subscribe/${site.buttondownUser}`} method="post" data-subscribe>
      <label class="sr" for="sub-email">Email address</label>
      <input id="sub-email" type="email" name="email" placeholder="you@email.com" required autocomplete="email" />
      <input type="hidden" value="1" name="embed" />
      <button class="btn" type="submit">Subscribe</button>
    </form>
    <p class="sub-msg" role="status" aria-live="polite" hidden></p>
    <small>Powered by Buttondown. We never share your email.</small>
  </div>
</div>
<script>
  // Subscribes in place (no popup, no redirect to Buttondown's public page) and shows the result under the form.
  document.querySelectorAll<HTMLFormElement>('form[data-subscribe]').forEach((form) => {
    const msg = form.parentElement!.querySelector<HTMLElement>('.sub-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button')!;
    const say = (t: string) => { msg.textContent = t; msg.hidden = false; };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true; say('Subscribing...');
      try {
        const res = await fetch(form.action, { method: 'POST', body: new URLSearchParams(new FormData(form) as any), redirect: 'manual' });
        // A good signup is answered with a redirect (to Buttondown's public page, which we do not use). A 400 does not always mean a bad address: it also comes back for addresses already waiting to confirm or that Buttondown blocks, so the message does not blame the address.
        if (res.ok || res.type === 'opaqueredirect' || (res.status >= 300 && res.status < 400)) { say('Almost done. If this address is not already on the list, a confirmation email is on its way. Check your spam or promotions folder. Already subscribed? You are all set.'); form.reset(); }
        else say('We could not add that address just now. If you already signed up, check your inbox (and spam) for the confirmation email. Otherwise, try again or email scott@hivenashville.com and I will add you.');
      } catch { say('Sorry, that did not go through. Please try again in a moment.'); }
      btn.disabled = false;
    });
  });
</script>
<style>
  .sub-msg{margin:10px 0 0;font-weight:700}
</style>
