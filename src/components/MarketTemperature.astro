---
import market from '../data/market.json';
const cities = market.cities as Record<string, any>;
---
<div class="mt-wrap" id="mtwrap" data-market={JSON.stringify(market)}>
  <div class="mtbox"><svg id="mticon" class="mti" viewBox="0 0 24 24" aria-hidden="true"></svg><span class="mt mid" id="mtitle">Market temperature</span></div>
  {market.sample && <span class="sample" style="margin-left:10px">Sample numbers</span>}
  <div class="market">
    <div class="pills" id="pills" role="group" aria-label="Choose a city">
      {Object.entries(cities).map(([k, c]) => <button type="button" data-city={k}>{c.name}</button>)}
    </div>
    <div class="gaugewrap">
      <svg viewBox="0 -4 240 144" role="img" aria-label="Market gauge" id="gauge"></svg>
      <div><div class="verdict" id="verdict"></div></div>
    </div>
    <div class="stats" id="stats"></div>
    <div class="src" id="src"></div>
  </div>
</div>
<script>
  const root = document.getElementById('mtwrap')!;
  const M = JSON.parse(root.dataset.market!);
  const ICON = {
    hot: '<defs><linearGradient id="fg" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#E0300A"/><stop offset=".6" stop-color="#FF6A1F"/><stop offset="1" stop-color="#FFA24D"/></linearGradient><linearGradient id="ig" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#FFB020"/><stop offset="1" stop-color="#FFF1B8"/></linearGradient></defs><g class="fl"><path d="M12.6 1.8c.5 3.3 2.8 4.8 4.5 7.1 1.3 1.8 2 3.5 2 5.4a7.1 7.1 0 0 1-14.2 0c0-2.4 1.1-4.1 2.6-5.4.3 1.7 1 2.7 2.1 3.2-.4-3.6.9-7.4 3-10.3z" fill="url(#fg)"/></g><g class="fl2"><path d="M12 21.6a3.9 3.9 0 0 1-3.9-3.9c0-2 1.5-3.2 2.6-4.7.5-.7.8-1.4.9-2.3 1.9 1.6 4.3 3.4 4.3 7a3.9 3.9 0 0 1-3.9 3.9z" fill="url(#ig)"/></g>',
    mid: '<g fill="none" stroke="#F0B93B" stroke-width="2" stroke-linecap="round"><path d="M10 14.5V5a2 2 0 1 1 4 0v9.5a4 4 0 1 1-4 0z"/><path d="M12 9v8"/></g>',
    cold: '<g class="snow" fill="none" stroke="#A5D8FF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><g><path d="M12 2v20M9.5 4.5 12 7l2.5-2.5M9.5 19.5 12 17l2.5 2.5"/></g><g transform="rotate(60 12 12)"><path d="M12 2v20M9.5 4.5 12 7l2.5-2.5M9.5 19.5 12 17l2.5 2.5"/></g><g transform="rotate(120 12 12)"><path d="M12 2v20M9.5 4.5 12 7l2.5-2.5M9.5 19.5 12 17l2.5 2.5"/></g></g>',
  } as Record<string, string>;
  const label = (m: number) => (m < 4 ? "Seller's market" : m <= 6 ? 'Balanced market' : "Buyer's market");
  const money = (v: number | null) => (v == null ? '—' : '$' + Math.round(v).toLocaleString());
  const val = (v: any, f: (x: any) => string = String) => (v == null ? '—' : f(v));
  let cur = Object.keys(M.cities)[0];
  function draw() {
    const c = M.cities[cur];
    const m = c.monthsSupply as number;
    const st = m < 4 ? 'hot' : m <= 6 ? 'mid' : 'cold';
    const title = document.getElementById('mtitle')!;
    title.className = 'mt ' + st;
    document.getElementById('mticon')!.innerHTML = ICON[st];
    const t = Math.min(m, 9) / 9, ang = Math.PI * (1 - t), cx = 120, cy = 120, r = 90;
    const A = (v: number) => Math.PI * (1 - v / 9);
    const arc = (a0: number, a1: number, col: string) => {
      const p0 = [cx + r * Math.cos(a0), cy - r * Math.sin(a0)], p1 = [cx + r * Math.cos(a1), cy - r * Math.sin(a1)];
      return `<path d="M${p0} A${r} ${r} 0 0 1 ${p1}" fill="none" stroke="${col}" stroke-width="16"/>`;
    };
    const nx = cx + (r - 10) * Math.cos(ang), ny = cy - (r - 10) * Math.sin(ang);
    document.getElementById('gauge')!.innerHTML =
      arc(A(0), A(4), '#F2593A') + arc(A(4), A(6), '#FFC20E') + arc(A(6), A(9), '#0E9F8E') +
      `<line x1="${cx}" y1="${cy}" x2="${nx}" y2="${ny}" stroke="#fff" stroke-width="4" stroke-linecap="round"/><circle cx="${cx}" cy="${cy}" r="8" fill="#fff"/>` +
      '<text x="14" y="136" fill="#8B95A3" font-size="10" font-family="sans-serif">Seller</text>' +
      '<text x="137" y="10" text-anchor="middle" fill="#C3CBD6" font-size="11" font-weight="600" font-family="sans-serif">Balanced</text>' +
      '<text x="196" y="136" fill="#8B95A3" font-size="10" font-family="sans-serif">Buyer</text>';
    document.getElementById('verdict')!.innerHTML = `${label(m)}<small>${m.toFixed(1)} months of supply${M.sample ? ' (sample)' : ''}</small>`;
    const stats: [string, string][] = [
      ['Median price', money(c.medianPrice)],
      ['Change YoY', val(c.yoy, (x) => (x > 0 ? '+' : '') + x.toFixed(1) + '%')],
      ['Days on market', val(c.dom)],
      ['Sale-to-list', val(c.saleToList, (x) => x.toFixed(1) + '%')],
      ['Active listings', val(c.inventory, (x) => Number(x).toLocaleString())],
      ['30-yr rate', val(M.mortgageRate30, (x) => x.toFixed(2) + '%')],
    ];
    document.getElementById('stats')!.innerHTML = stats.map(([k, v]) => `<div class="stat"><span>${k}</span><b>${v}</b></div>`).join('');
    document.getElementById('src')!.textContent = M.sample
      ? 'Real figures, sources and "as of" date will appear here from the monthly data files. The gauge position above is a sample.'
      : `Data as of ${M.asOf}. Sources: ${M.sources.join('; ')}.`;
    root.querySelectorAll<HTMLButtonElement>('#pills button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.city === cur)));
  }
  root.querySelectorAll<HTMLButtonElement>('#pills button').forEach((b) => b.addEventListener('click', () => { cur = b.dataset.city!; draw(); }));
  draw();
</script>
