---
// Thin wrapper. All the logic and look live in src/widgets/market-temperature.ts (plug-and-play).
// Data: public/data/market.json (see docs/data-contracts/market.md).
const { city, selector = true, title = true, src = '/data/market.json' } = Astro.props;
---
<tpa-market-temperature src={src} city={city} show-selector={String(selector)} show-title={String(title)}></tpa-market-temperature>
