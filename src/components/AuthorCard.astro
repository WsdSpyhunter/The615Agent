---
import { site } from '../site.config';
---
<aside class="author-card" aria-label="About the author">
  <img class="ac-photo" src="/img/scott-davis-headshot-2.webp" alt={`${site.agent}, ${site.title ?? 'REALTOR®'}`} width="132" height="132" loading="lazy" decoding="async" />
  <div class="ac-text">
    <div class="ac-kick">About the author</div>
    <h3>{site.agent}, REALTOR®</h3>
    <div class="ac-lic">{site.name} · {site.brokerage} · {site.license}</div>
    <p class="ac-bio">I help people buy, sell, invest and relocate along the I-65 corridor south of Nashville. Questions about anything in this post? Reach out and I will get back to you.</p>
    <div class="ac-btns">
      <a class="btn primary" href="/contact">Contact me</a>
      <a class="btn ghost" href="/buy#form">Get matched with homes</a>
      <a class="ac-phone" href={`tel:${site.phoneHref}`}>{site.phone}</a>
    </div>
  </div>
  <div class="ac-marks">
    <span class="ac-tile"><img src="/img/logo-615-agent.webp" alt={site.name} width="130" height="66" loading="lazy" decoding="async" /></span>
    <span class="ac-eho">Equal Housing Opportunity. Information is general in nature and is not legal, tax, lending or financial advice.</span>
    <span class="ac-tile"><img src="/img/hive-nashville.png" alt={site.brokerage} width="120" height="43" loading="lazy" decoding="async" /></span>
  </div>
</aside>
