---
const { eyebrow, title, lead, center } = Astro.props;
---
<section class={center ? 'phead center-m' : 'phead'}>
  <div class="wrap">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<div class="bar" aria-hidden="true"></div>
