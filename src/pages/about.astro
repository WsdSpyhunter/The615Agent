---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../site.config';
const schema = { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'About Scott Davis', url: `${site.url}/about` };
---
<Layout title="About Scott Davis, Realtor" description="Scott Davis is a Tennessee licensed Realtor with Hive Nashville helping buyers, sellers, relocators and investors in Williamson County and Middle Tennessee." schema={schema}>
  <PageHeader eyebrow="About" title="Scott Davis, <em>Realtor</em>" lead="Helping buyers, sellers, relocators and investors across Williamson County and Middle Tennessee." />
  <section class="s"><div class="wrap two about">
    <img src="/img/scott-davis.webp" alt="Scott Davis, Realtor with Hive Nashville" width="256" height="320" style="width:100%;max-width:320px;border-radius:24px;border:4px solid var(--gold)" />
    <div class="prose">
      <p>I'm Scott Davis, a Tennessee licensed real estate professional affiliated with {site.brokerage}. I help people buy, sell and relocate along the I-65 corridor south of Nashville, including Franklin, Brentwood, Spring Hill, Thompson's Station and Nolensville.</p>
      <h2>How I work</h2>
      <ul>
        <li><b>Straight answers.</b> You get my honest opinion, even when it is not what you hoped to hear.</li>
        <li><b>No pressure.</b> You decide the pace. I explain the options and the trade-offs.</li>
        <li><b>A call first.</b> When you reach out, we'll be talking within the next 48 hours.</li>
      </ul>
      <p>Questions at any step? I'm one call or text away: <a href={`tel:${site.phoneHref}`}>{site.phone}</a> or <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      <div class="cta-row" style="margin-top:24px"><a class="btn primary" href="/buy#form">Get Matched With Homes</a><a class="btn dark" href="/contact">Contact me</a></div>
      <p class="hint" style="margin-top:20px">{site.agent} · {site.license} · {site.brokerage}</p>
    </div>
  </div></section>
</Layout>
