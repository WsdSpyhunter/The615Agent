---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import LeadForm from '../components/LeadForm.astro';
import ColorBar from '../components/ColorBar.astro';
import { site, areas } from '../site.config';
---
<Layout title="Get Matched With Homes in Williamson County and Middle TN" description="Tell me your budget, area and timeline, then schedule a call with Scott Davis. Buyer guidance for Franklin, Brentwood, Spring Hill, Thompson's Station and Nolensville.">
  <PageHeader eyebrow="Buyers" title="Get matched with <em>homes</em>" lead="Tell me your budget, area and timeline, then schedule a call with me. We'll be talking within the next 48 hours." />
  <section class="s" id="form"><div class="wrap contact">
    <div class="info">
      <span class="kicker">How it works</span>
      <h2 class="h2">A call first, then a plan</h2>
      <ol class="bullets">
        <li>Fill out the short form.</li>
        <li>We get on a call within the next 48 hours to talk through what you want.</li>
        <li>I help you with the next steps, from pre-approval to touring homes.</li>
      </ol>
      <p class="hint">Prefer to talk now? Call or text <a href={`tel:${site.phoneHref}`} style="text-decoration:underline">{site.phone}</a>.</p>
      <div class="brandstack">
        <img class="headshot" src="/img/scott-davis.webp" alt="Scott Davis, Realtor with Hive Nashville" width="150" height="150" loading="lazy" decoding="async" />
        <div class="logotile"><img src="/img/logo-615-agent.webp" alt="The 615 Agent" width="648" height="329" loading="lazy" decoding="async" /></div>
      </div>
    </div>
    <LeadForm type="buyer" id="buyer-form" />
  </div></section>
  {site.idx.enabled && (
    <section class="s band" id="search"><div class="wrap">
      {site.idx.embedHtml ? <Fragment set:html={site.idx.embedHtml} /> : <a class="btn primary" href={site.idx.searchUrl}>Search homes</a>}
    </div></section>
  )}
  <ColorBar rev />
  <section class="s band"><div class="wrap">
    <div class="sh"><div><span class="kicker navy">Buyer guides</span><h2>Helpful tools for buyers</h2></div></div>
    <div class="cardgrid">
      <a class="card t1" href="/checklists"><h3>Buyer's moving checklist</h3><p>From pre-approval to your first 30 days at home. View online or download the PDF.</p></a>
      <a class="card t2" href="/mortgage-calculator"><h3>Mortgage calculator</h3><p>Estimate your monthly payment with taxes, insurance and mortgage insurance.</p></a>
      <a class="card t3" href="/market-data"><h3>Market data</h3><p>See how the market is moving in each city along the I-65 corridor.</p></a>
      <a class="card t4" href="/resources"><h3>Local resources</h3><p>County property search, school districts, utilities and lender programs.</p></a>
      <a class="card t1" href="/blog"><h3>The blog</h3><p>Guides for buyers, relocators and first-time homeowners.</p></a>
      <a class="card t2" href={`/areas/${areas[0].slug}`}><h3>Explore the areas</h3><p>Franklin, Brentwood, Spring Hill, Thompson's Station and Nolensville.</p></a>
    </div>
  </div></section>
</Layout>
