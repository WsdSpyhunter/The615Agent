---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import LeadForm from '../components/LeadForm.astro';
import ColorBar from '../components/ColorBar.astro';
import checklists from '../data/checklists.json';
import { site } from '../site.config';
const cards = [
  { key: 'buyer', chip: "Buyer's edition", cls: '', title: "Buyer's Moving Checklist", desc: 'From pre-approval to your first 30 days at home. Eight stages, from getting ready to buy through settling in.', pdf: '/downloads/buyer-moving-checklist.pdf', img: '/img/checklist-buyer' },
  { key: 'seller', chip: "Seller's edition", cls: 'gold', title: "Seller's Moving Checklist", desc: 'From your first conversation about selling to your last box out the door. Eight stages, from preparing to sell through the move.', pdf: '/downloads/seller-moving-checklist.pdf', img: '/img/checklist-seller' },
];
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Buyer and Seller Moving Checklists', url: `${site.url}/checklists`,
  hasPart: cards.map((c) => ({ '@type': 'DigitalDocument', name: c.title, encodingFormat: 'application/pdf', url: `${site.url}${c.pdf}` })),
};
---
<Layout title="Free Moving Checklists for Buyers and Sellers" description="Free buyer and seller moving checklists for Middle Tennessee. Read them online, check items off as you go, or download the PDF." schema={schema}>
  <PageHeader eyebrow="Free resources" title="Moving checklists for buyers and <em>sellers</em>" lead="Step-by-step guides from first conversation to first 30 days at home. Read them online, check items off as you go, or download the PDF to keep." />
  <section class="s"><div class="wrap">
    <div class="cl2">
      {cards.map((c) => (
        <article class="clcard">
          <div class="thumb"><picture><source type="image/webp" srcset={`${c.img}.webp`} /><img src={`${c.img}.jpg`} alt={`First page of the ${c.title}`} width="850" height="1100" loading="lazy" /></picture></div>
          <div class="clbody">
            <span class={`chip ${c.cls}`}>{c.chip}</span>
            <h2>{c.title}</h2>
            <p>{c.desc}</p>
            <div class="meta">3 pages · PDF</div>
            <div class="btns">
              <a class="btn primary" href={c.pdf} target="_blank" rel="noopener" aria-label={`View ${c.title} online (PDF)`}>View online</a>
              <a class="btn dark dl" href={c.pdf} download>Download PDF</a>
              <button class="btn ghost sm" type="button" data-tab={c.key} style="color:var(--fg)">Use the interactive version</button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div></section>
  <ColorBar rev />
  <section class="s band" id="read"><div class="wrap narrow2">
    <div class="sh"><div><span class="kicker navy">Read it online</span><h2>Check items off as you go</h2><p>Your progress is saved on this device. Nothing is sent to anyone.</p></div></div>
    <div class="tabs" role="tablist" aria-label="Choose a checklist">
      <button role="tab" id="tab-buyer" aria-selected="true" data-tab="buyer">Buyer</button>
      <button role="tab" id="tab-seller" aria-selected="false" data-tab="seller">Seller</button>
    </div>
    <div class="prog"><div class="progbar"><i id="bar"></i></div><span id="ptxt"></span><button id="reset" type="button">Reset</button></div>
    <div id="steps" data-lists={JSON.stringify(checklists)}></div>
  </div></section>
  <ColorBar />
  <section class="s"><div class="wrap narrow">
    <div class="sh"><div><span class="kicker">Want a copy?</span><h2>Have it emailed to you</h2><p>Tell me where to send it. I'll email your checklist shortly.</p></div></div>
    <LeadForm type="checklist" id="checklist-form" />
  </div></section>
  <ColorBar rev />
  <section class="ctab"><div class="wrap">
    <div><h2>Questions at any step? I'm one call or text away.</h2><p>Know someone planning a move? I'd be honored by the introduction.</p></div>
    <div class="cbtns"><a class="btn primary" href={`tel:${site.phoneHref}`}>Call {site.phone}</a><a class="btn ghost" href="/contact">Send a message</a></div>
  </div></section>
</Layout>
<script>
  type Step = { title: string; when: string; items: string[]; tip: string };
  const host = document.getElementById('steps')!;
  const DATA = JSON.parse(host.dataset.lists!) as Record<string, Step[]>;
  let cur = 'buyer';
  let state: Record<string, number> = {};
  try { state = JSON.parse(localStorage.getItem('cl615') || '{}'); } catch {}
  const save = () => { try { localStorage.setItem('cl615', JSON.stringify(state)); } catch {} };
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  function update() {
    const all = host.querySelectorAll('input').length;
    const done = host.querySelectorAll('input:checked').length;
    (document.getElementById('bar') as HTMLElement).style.width = (all ? (done / all) * 100 : 0) + '%';
    document.getElementById('ptxt')!.textContent = `${done} of ${all} done`;
  }
  function render() {
    host.innerHTML = DATA[cur].map((s, i) => `<section class="stp"><header><span class="n">${i + 1}</span><h3>${esc(s.title)}</h3><span class="when">${esc(s.when)}</span></header><ul>${
      s.items.map((it, j) => { const id = `${cur}-${i}-${j}`; return `<li><label><input type="checkbox" data-id="${id}"${state[id] ? ' checked' : ''}><span>${esc(it)}</span></label></li>`; }).join('')
    }</ul>${s.tip ? `<p class="tip">${esc(s.tip)}</p>` : ''}</section>`).join('');
    update();
  }
  host.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement; const id = t.dataset.id; if (!id) return;
    if (t.checked) state[id] = 1; else delete state[id];
    save(); update();
  });
  function tab(k: string, scroll = false) {
    cur = k;
    document.querySelectorAll<HTMLElement>('[role=tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === k)));
    render();
    if (scroll) document.getElementById('read')!.scrollIntoView({ behavior: 'smooth' });
  }
  document.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => tab(b.dataset.tab!, !b.hasAttribute('role'))));
  document.getElementById('reset')!.addEventListener('click', () => { Object.keys(state).forEach((k) => { if (k.startsWith(cur + '-')) delete state[k]; }); save(); render(); });
  render();
</script>
