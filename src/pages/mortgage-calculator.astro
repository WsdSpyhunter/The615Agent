---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ColorBar from '../components/ColorBar.astro';
import { site } from '../site.config';
import taxRates from '../../public/data/property-tax-rates.json';
const faq = [
  { q: 'How is the monthly payment calculated?', a: 'The calculator adds up to five parts: principal and interest on the loan, property tax, home insurance, mortgage insurance when it applies, and any HOA dues. Principal and interest come from the loan amount, the interest rate and the loan term. The other parts are estimates that you can change.' },
  { q: 'How does property tax work in Tennessee?', a: 'Residential property in Tennessee is assessed at 25 percent of its appraised value. The yearly tax is the assessed value divided by 100, multiplied by the combined rate per $100 set by the county, the city and, in some places, a school district. Rates differ by area, so the area list fills in an estimate that you can overwrite. The calculator applies the area\'s latest rate to the purchase price, but the county\'s appraisal and later rate changes can make a real bill different.' },
  { q: 'How much are closing costs?', a: 'Closing costs typically run 2 to 4 percent of the purchase price, plus earnest money and moving costs. The calculator shows a range for your estimated cash to close: your down payment plus 2 to 4 percent of the price.' },
  { q: 'Do I need mortgage insurance if I put less than 20 percent down?', a: 'Private mortgage insurance is typically required on conventional loans when the down payment is under 20 percent. FHA loans allow a down payment as low as 3.5 percent. VA loans typically require no down payment and no monthly mortgage insurance, though a funding fee may apply. For FHA, the calculator adds HUD\'s 1.75% upfront premium to the loan and uses HUD\'s published annual premium for your loan term, loan size and down payment (HUD Mortgagee Letter 2023-05). For VA, it adds the VA funding fee for first-time use (1.25% to 2.15% depending on the down payment, per VA.gov), and veterans who are exempt can remove it under More options. These are estimates, and your lender can give you exact figures.' },
  { q: 'Where does the default interest rate come from?', a: "It is Freddie Mac's most recent weekly average 30-year fixed mortgage rate, published by the Federal Reserve Bank of St. Louis. It is an average, not a quote, so use the rate in your lender's quote when you have one." },
  { q: 'What does extra principal do?', a: 'Extra principal is money you pay toward the loan balance on top of the required payment each month. It shortens the loan and reduces the total interest. Open "More options" in the calculator to try it.' },
  { q: 'Is this a loan offer?', a: 'No. The calculator gives estimates only and is not a loan offer or a commitment to lend. Actual rates, taxes, insurance, mortgage insurance and fees vary. The 615 Agent is not a lender.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Mortgage Calculator', url: `${site.url}/mortgage-calculator`, applicationCategory: 'FinanceApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })) },
];
---
<Layout title="Mortgage Calculator: Monthly Payment With Taxes and Insurance" description="Free mortgage calculator for Franklin, Nashville and Middle Tennessee homebuyers. Estimate your payment with property tax by area, insurance and extra payments." schema={schema}>
  <PageHeader eyebrow="Mortgage calculator" title="What will your payment <em>really</em> be?" lead="A free mortgage calculator for Franklin, Nashville and Middle Tennessee homebuyers. Adjust the numbers and watch your monthly payment, interest and payoff time update instantly. Everything runs in your browser. Nothing you type is sent anywhere." />
  <section class="s"><div class="wrap" style="max-width:1320px">
    <tpa-mortgage-calculator rate-src="/data/market.json" tax-src="/data/property-tax-rates.json" default-area="nashville" default-rate="6.5" contact-url="/contact" cta-label="Talk to Scott about these numbers" brand={site.name} logo-src="/img/logo-615-agent.webp" logo-alt="The 615 Agent"></tpa-mortgage-calculator>
  </div></section>
  <ColorBar rev />
  <section class="s band"><div class="wrap prose" style="max-width:820px;margin-inline:auto">
    <div class="sh center"><div><span class="kicker navy">Good to know</span><h2>Mortgage calculator questions</h2></div></div>
    <div class="faq">{faq.map((x, i) => <details open={i === 0}><summary>{x.q}</summary><p>{x.a}</p></details>)}</div>
    <h3 style="margin-top:28px;font-size:1.15rem;text-align:center">Property tax rates in the area list</h3>
    <div class="taxwrap"><table class="taxtable"><caption>Combined rate per $100 of assessed value, as listed in the calculator</caption>
      <thead><tr><th>Area</th><th>Rate per $100</th></tr></thead>
      <tbody>{taxRates.areas.map((a: any) => <tr><td>{a.label}</td><td>${a.rate.toFixed(a.rate.toFixed(4).replace(/0+$/, '').split('.')[1].length > 3 ? 4 : 3)}</td></tr>)}</tbody></table></div>
    <p class="hint" style="margin-top:12px">These are the latest rates found for each area: 2026 for Williamson and Rutherford counties, and 2025 for Davidson and Maury counties (Maury County is in a 2026 reappraisal year, so its 2026 rates may be lower). A listing&#39;s tax figure is usually last year&#39;s bill on the seller&#39;s assessment, while the calculator applies the rate to the purchase price. Sources: {taxRates.sources.map((x: any, k: number) => <><a href={x.url} rel="noopener" target="_blank">{x.name}</a>{k < taxRates.sources.length - 1 ? '; ' : '.'}</>)} For the details behind each local rate, see the property tax pages for <a href="/franklin/property-taxes">Franklin</a>, <a href="/brentwood/property-taxes">Brentwood</a>, <a href="/spring-hill/property-taxes">Spring Hill</a>, <a href="/nashville/property-taxes">Nashville</a> and the other <a href="/franklin">city guides</a>. This page is general information, not legal, tax, lending or financial advice. Equal Housing Opportunity.</p>
  </div></section>
</Layout>
<style>
  .taxwrap{overflow-x:auto;margin-top:10px}
  .taxtable{width:100%;border-collapse:collapse;font-size:15px}
  .taxtable caption{text-align:left;font-weight:700;padding:0 12px 8px;color:var(--muted)}
  .taxtable th,.taxtable td{padding:9px 12px;text-align:left;border-bottom:1px solid var(--line)}
  .taxtable th:last-child,.taxtable td:last-child{text-align:right;white-space:nowrap}
  .taxtable thead th{font-size:12.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
</style>
