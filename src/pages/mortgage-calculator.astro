---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import market from '../data/market.json';
import { site } from '../site.config';
const rate = market.mortgageRate30 ?? 6.5;
const schema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Mortgage Calculator', url: `${site.url}/mortgage-calculator`, applicationCategory: 'FinanceApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } };
---
<Layout title="Mortgage Calculator: Monthly Payment With Taxes and Insurance" description="Free mortgage calculator for Tennessee homebuyers. Estimate your monthly payment with property tax, insurance, mortgage insurance and extra payments, plus an amortization chart." schema={schema}>
  <PageHeader eyebrow="Mortgage calculator" title="What will your payment <em>really</em> be?" lead="Adjust the numbers and watch your monthly payment, interest and payoff date update instantly. Everything runs in your browser. Nothing you type is sent anywhere." />
  <section class="s"><div class="wrap">
    <div class="mc" id="mc" data-rate={rate}>
      <div class="panel">
        <div class="field">
          <div class="top"><label for="price">Home price</label><output id="o-price"></output></div>
          <input id="price" type="range" min="100000" max="2000000" step="5000" value="600000" />
        </div>
        <div class="field">
          <div class="top"><label for="down">Down payment</label><output id="o-down"></output></div>
          <input id="down" type="range" min="0" max="50" step="0.5" value="20" />
          <div class="num"><input id="downamt" inputmode="numeric" aria-label="Down payment in dollars" /><input id="downpct" inputmode="decimal" aria-label="Down payment percent" /></div>
        </div>
        <div class="field">
          <div class="top"><label for="rate">Interest rate</label><output id="o-rate"></output></div>
          <input id="rate" type="range" min="2" max="10" step="0.125" value={rate} />
          <small class="hint">Example rate. Use the rate from your lender's quote.</small>
        </div>
        <div class="field">
          <div class="top"><span>Loan term</span></div>
          <div class="seg" id="term" role="group" aria-label="Loan term"><button type="button" data-v="30" aria-pressed="true">30 years</button><button type="button" data-v="20" aria-pressed="false">20 years</button><button type="button" data-v="15" aria-pressed="false">15 years</button></div>
        </div>
        <div class="field">
          <div class="top"><span>Loan type</span></div>
          <div class="seg" id="ltype" role="group" aria-label="Loan type"><button type="button" data-v="conv" aria-pressed="true">Conventional</button><button type="button" data-v="fha" aria-pressed="false">FHA</button><button type="button" data-v="va" aria-pressed="false">VA</button></div>
          <small class="hint" id="ltype-note"></small>
        </div>
        <div class="two-in" style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
          <div class="field"><div class="top"><label for="tax">Property tax (% of price / yr)</label></div><input id="tax" type="number" step="0.01" min="0" value="0.65" /></div>
          <div class="field"><div class="top"><label for="ins">Home insurance ($ / yr)</label></div><input id="ins" type="number" step="50" min="0" value="1800" /></div>
          <div class="field"><div class="top"><label for="hoa">HOA ($ / month)</label></div><input id="hoa" type="number" step="10" min="0" value="0" /></div>
          <div class="field"><div class="top"><label for="extra">Extra principal ($ / month)</label></div><input id="extra" type="number" step="25" min="0" value="0" /></div>
        </div>
        <p class="hint" style="margin:0">Property tax and insurance are example values. Tax depends on the home's assessment and its location, and insurance depends on the home and carrier. Look up a specific property in the <a href="/resources" style="text-decoration:underline">county property search</a> and get a quote for real numbers.</p>
      </div>

      <div class="res" aria-live="polite">
        <div><small>Estimated monthly payment</small><div class="big" id="total"></div></div>
        <div class="donutwrap">
          <svg id="donut" viewBox="0 0 120 120" width="150" height="150" role="img" aria-label="Payment breakdown"></svg>
          <div class="legend" id="legend"></div>
        </div>
        <div class="totals" id="totals"></div>
        <div class="chart"><svg id="chart" viewBox="0 0 520 240" role="img" aria-label="Loan balance and cumulative interest over time"></svg></div>
        <p class="note" id="chartnote"></p>
        <a class="btn gold" id="talk" href="/contact">Talk to Scott about these numbers</a>
        <p class="note">Estimates only, not a loan offer or commitment to lend. Actual rates, taxes, insurance, mortgage insurance and fees vary. {site.name} is not a lender. Equal Housing Opportunity.</p>
      </div>
    </div>
  </div></section>
</Layout>
<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const money = (v: number) => '$' + Math.round(v).toLocaleString();
  const money2 = (v: number) => '$' + v.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  let term = 30, ltype = 'conv';
  const price = $<HTMLInputElement>('price'), down = $<HTMLInputElement>('down'), rate = $<HTMLInputElement>('rate');
  const downamt = $<HTMLInputElement>('downamt'), downpct = $<HTMLInputElement>('downpct');
  const tax = $<HTMLInputElement>('tax'), ins = $<HTMLInputElement>('ins'), hoa = $<HTMLInputElement>('hoa'), extra = $<HTMLInputElement>('extra');
  const COLORS = { pi: '#1473E6', tax: '#FFC20E', ins: '#F2593A', mi: '#A5D8FF', hoa: '#8B95A3' };
  const NOTES: Record<string, string> = {
    conv: 'Mortgage insurance (PMI) is estimated when your down payment is under 20%.',
    fha: 'Estimates a 1.75% upfront premium added to the loan and a 0.55% annual premium. FHA allows as little as 3.5% down.',
    va: 'No monthly mortgage insurance. A VA funding fee may apply and is not included.',
  };
  function payment(L: number, annual: number, n: number) {
    const r = annual / 1200;
    return r === 0 ? L / n : (L * r) / (1 - Math.pow(1 + r, -n));
  }
  function calc() {
    const P = +price.value;
    let dp = +down.value;
    const dAmt = (P * dp) / 100;
    if (ltype === 'fha' && dp < 3.5) dp = 3.5;
    let L = P - (P * dp) / 100;
    let mi = 0;
    if (ltype === 'fha') { L *= 1.0175; mi = (L * 0.0055) / 12; }
    else if (ltype === 'conv' && dp < 20) mi = (L * 0.005) / 12;
    const n = term * 12, ann = +rate.value;
    const pi = payment(L, ann, n);
    const tx = (P * (+tax.value || 0)) / 100 / 12, is = (+ins.value || 0) / 12, h = +hoa.value || 0, ex = +extra.value || 0;
    const total = pi + tx + is + mi + h;
    // amortization
    const r = ann / 1200;
    let bal = L, cumInt = 0, m = 0;
    const pts: { m: number; bal: number; int: number }[] = [{ m: 0, bal, int: 0 }];
    while (bal > 0.005 && m < n + 1) {
      const i = bal * r; let pr = pi + ex - i;
      if (pr > bal) pr = bal;
      bal -= pr; cumInt += i; m++;
      pts.push({ m, bal: Math.max(bal, 0), int: cumInt });
    }
    let base = 0, bb = L; for (let k = 0; k < n; k++) { const i = bb * r; base += i; bb -= pi - i; }
    return { P, dp, dAmt, L, pi, tx, is, mi, h, total, pts, months: m, interest: cumInt, saved: Math.max(base - cumInt, 0), ex, n };
  }
  function donut(parts: { k: keyof typeof COLORS; v: number }[]) {
    const tot = parts.reduce((a, p) => a + p.v, 0) || 1; const R = 44, C = 2 * Math.PI * R; let off = 0;
    $('donut').innerHTML = '<circle cx="60" cy="60" r="44" fill="none" stroke="#232A32" stroke-width="16"/>' + parts.filter((p) => p.v > 0).map((p) => {
      const len = (p.v / tot) * C; const s = `<circle cx="60" cy="60" r="${R}" fill="none" stroke="${COLORS[p.k]}" stroke-width="16" stroke-dasharray="${len} ${C - len}" stroke-dashoffset="${-off}" transform="rotate(-90 60 60)"/>`; off += len; return s;
    }).join('');
  }
  function chart(c: ReturnType<typeof calc>) {
    const W = 520, H = 240, pl = 52, pr = 26, pt = 14, pb = 28;
    const maxM = c.pts[c.pts.length - 1].m || 1, maxY = Math.max(c.L, c.interest, 1);
    const X = (m: number) => pl + (m / maxM) * (W - pl - pr), Y = (v: number) => pt + (1 - v / maxY) * (H - pt - pb);
    const path = (k: 'bal' | 'int') => c.pts.filter((_, i) => i % Math.ceil(c.pts.length / 120) === 0 || i === c.pts.length - 1).map((p, i) => `${i ? 'L' : 'M'}${X(p.m).toFixed(1)} ${Y(p[k]).toFixed(1)}`).join('');
    let g = '';
    for (let i = 0; i <= 4; i++) { const v = (maxY * i) / 4; g += `<line x1="${pl}" x2="${W - pr}" y1="${Y(v)}" y2="${Y(v)}" stroke="#232A32"/><text x="${pl - 6}" y="${Y(v) + 4}" fill="#8B95A3" font-size="10" text-anchor="end" font-family="sans-serif">$${v >= 1e6 ? (v / 1e6).toFixed(1) + 'M' : Math.round(v / 1000) + 'k'}</text>`; }
    const yrs = Math.ceil(maxM / 12), step = yrs > 20 ? 10 : 5;
    for (let y = 0; y <= yrs; y += step) g += `<text x="${X(y * 12)}" y="${H - 8}" fill="#8B95A3" font-size="10" text-anchor="middle" font-family="sans-serif">${y === 0 ? 'Start' : 'Yr ' + y}</text>`;
    $('chart').innerHTML = g + `<path d="${path('bal')}" fill="none" stroke="#1473E6" stroke-width="2.5"/><path d="${path('int')}" fill="none" stroke="#FFC20E" stroke-width="2.5"/>` +
      `<g font-size="11" font-family="sans-serif"><rect x="${pl + 8}" y="${pt + 2}" width="10" height="10" rx="2" fill="#1473E6"/><text x="${pl + 24}" y="${pt + 11}" fill="#C9D1DB">Loan balance</text><rect x="${pl + 110}" y="${pt + 2}" width="10" height="10" rx="2" fill="#FFC20E"/><text x="${pl + 126}" y="${pt + 11}" fill="#C9D1DB">Total interest paid</text></g>`;
  }
  function render() {
    const c = calc();
    $('o-price').textContent = money(c.P); $('o-rate').textContent = (+rate.value).toFixed(3).replace(/0$/, '') + '%'; $('o-down').textContent = `${money(c.dAmt)} (${(+down.value).toFixed(1)}%)`;
    if (document.activeElement !== downamt) downamt.value = Math.round(c.dAmt).toLocaleString();
    if (document.activeElement !== downpct) downpct.value = (+down.value).toFixed(1);
    $('total').textContent = money2(c.total);
    const parts = [{ k: 'pi' as const, n: 'Principal & interest', v: c.pi }, { k: 'tax' as const, n: 'Property tax', v: c.tx }, { k: 'ins' as const, n: 'Home insurance', v: c.is }, { k: 'mi' as const, n: 'Mortgage insurance', v: c.mi }, { k: 'hoa' as const, n: 'HOA', v: c.h }];
    donut(parts);
    $('legend').innerHTML = parts.filter((p) => p.v > 0).map((p) => `<div><i style="background:${COLORS[p.k]}"></i>${p.n}<b>${money2(p.v)}</b></div>`).join('');
    const yrs = Math.floor(c.months / 12), mo = c.months % 12;
    $('totals').innerHTML = `<div><span>Loan amount</span><b>${money(c.L)}</b></div><div><span>Total interest</span><b>${money(c.interest)}</b></div><div><span>Paid off in</span><b>${yrs} yr${mo ? ' ' + mo + ' mo' : ''}</b></div><div><span>${c.ex > 0 ? 'Interest saved' : 'Down payment'}</span><b>${c.ex > 0 ? money(c.saved) : money(c.dAmt)}</b></div>`;
    chart(c);
    $('chartnote').textContent = c.mi > 0 && ltype === 'conv' ? 'Mortgage insurance typically ends once you reach 20% equity. The chart shows principal and interest only.' : 'The chart shows principal and interest only.';
    $('ltype-note').textContent = NOTES[ltype];
    const note = `Mortgage calculator numbers: price ${money(c.P)}, down ${money(c.dAmt)} (${(+down.value).toFixed(1)}%), ${term}-year ${ltype === 'conv' ? 'conventional' : ltype.toUpperCase()} at ${(+rate.value)}%, estimated payment ${money2(c.total)}/month.`;
    ($('talk') as HTMLAnchorElement).href = '/contact?note=' + encodeURIComponent(note);
  }
  [price, down, rate, tax, ins, hoa, extra].forEach((e) => e.addEventListener('input', render));
  downamt.addEventListener('input', () => { const v = +downamt.value.replace(/[^0-9.]/g, ''); down.value = String(Math.min(50, Math.max(0, (v / +price.value) * 100))); render(); });
  downpct.addEventListener('input', () => { const v = +downpct.value; if (!isNaN(v)) { down.value = String(Math.min(50, Math.max(0, v))); render(); } });
  [['term', (v: string) => (term = +v)], ['ltype', (v: string) => (ltype = v)]].forEach(([id, set]) => {
    const g = $(id as string);
    g.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
      (set as (v: string) => void)((b as HTMLElement).dataset.v!);
      g.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    }));
  });
  render();
</script>
