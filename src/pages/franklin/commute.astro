---
import GuideLayout from "../../layouts/GuideLayout.astro";
import ColorBar from "../../components/ColorBar.astro";
import GuideClose from "../../components/GuideClose.astro";
import { site } from "../../site.config";
import { M, C, usd, num, dateLong, monthShort, signed, censusRows, CITY_TAX_RATE } from "../../lib-guide";
const f = M.cities.franklin, cf = C.cities.franklin, when = dateLong(f.asOf);
const UPDATED = C.retrieved;
const acs = "U.S. Census Bureau, American Community Survey 5-Year Estimates (2020-2024)";
const faqSchema = (faq: any[]) => ({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((x) => ({ "@type": "Question", name: x.q, acceptedAnswer: { "@type": "Answer", text: x.a } })) });
const rows = censusRows();
const title = `Franklin TN Commute Times: Census Average (${C.vintage.slice(0,4)})`;
const description = `The average commute for Franklin, TN workers is ${cf.meanCommuteMinutes} minutes each way, compared with nearby cities. U.S. Census Bureau American Community Survey data.`;
const faq = [
  { q: "What is the average commute time in Franklin, TN?", a: `The U.S. Census Bureau's American Community Survey (2020-2024) puts the average travel time to work for Franklin city residents at ${cf.meanCommuteMinutes} minutes each way. It is an average across all workers who traveled to work, so individual commutes vary widely by workplace, route and time of day.` },
  { q: "Does the commute figure include people who work from home?", a: "No. The Census figure is the mean travel time to work for workers 16 and over who did not work at home." },
  { q: "How do I check the commute from a specific Franklin address?", a: "Commutes depend on the exact address, the destination and the time of day. A mapping app's departure-time estimate for your own route at your own hours is the most useful check before you decide on a home." },
];
const schema = [faqSchema(faq), { "@context": "https://schema.org", "@type": "Dataset", name: "Mean travel time to work, Franklin TN and nearby cities", url: `${site.url}/franklin/commute`, creator: { "@type": "Organization", name: "U.S. Census Bureau", url: "https://www.census.gov/programs-surveys/acs" }, publisher: { "@id": `${site.url}/#agent` }, isAccessibleForFree: true, spatialCoverage: { "@type": "City", name: "Franklin, Tennessee" }, temporalCoverage: "2020/2024", dateModified: UPDATED }];
---
<GuideLayout title={title} description={description} h1={`Franklin, TN <em>commute times</em>`} lead="The average commute for Franklin, Tennessee workers, next to nearby cities, from the U.S. Census Bureau." slug="commute" label="Commute" updated={UPDATED} schema={schema}>
  <section class="s"><div class="wrap">
    <div class="sh"><div><span class="kicker navy">{acs}</span><h2>Franklin commute at a glance</h2></div></div>
    <p class="answer">Workers who live in Franklin, Tennessee spend an average of {cf.meanCommuteMinutes} minutes getting to work each way, according to the Census Bureau's American Community Survey (2020-2024 estimates). That is an average for the whole city, so a commute from any one home depends on where the job is and when you travel.</p>
    <div class="stats"><div class="stat"><span>Average commute</span><b>{cf.meanCommuteMinutes} min</b><small>each way, Franklin city</small></div><div class="stat"><span>Population</span><b>{num(cf.population)}</b><small>Franklin city</small></div></div>
  </div></section>
  <ColorBar rev />
  <section class="s band"><div class="wrap">
    <div class="sh"><div><span class="kicker navy">City by city</span><h2>Average commute: Franklin and nearby cities</h2><p>Numbers only, listed alphabetically after Franklin. Commutes depend on where people work, so a shorter or longer average is not a ranking.</p></div></div>
    <div class="tablewrap"><table class="data"><caption>Mean travel time to work, minutes ({acs})</caption>
      <thead><tr><th>City</th><th>Average commute (min)</th></tr></thead>
      <tbody>{rows.map(([k, c]) => <tr><td>{c.name}</td><td>{c.meanCommuteMinutes}</td></tr>)}</tbody></table></div>
    <p class="sources" style="margin-top:12px">Source: <a href="https://www.census.gov/programs-surveys/acs" rel="noopener" target="_blank">U.S. Census Bureau, American Community Survey</a>, 5-year estimates for 2020-2024 (Data Profile DP03). Estimates have margins of error and are for workers who traveled to work, not those who worked at home.</p>
  </div></section>
  <section class="s"><div class="wrap">
    <div class="sh"><div><span class="kicker navy">Common questions</span><h2>Franklin commute FAQ</h2></div></div>
    <div class="faq">{faq.map((x, i) => <details open={i === 0}><summary>{x.q}</summary><p>{x.a}</p></details>)}</div>
    <p class="sources" style="margin-top:14px">This page is general information, not legal, tax, lending or financial advice. Equal Housing Opportunity.</p>
    <div class="linkgrid" style="margin-top:18px">
      <a href="/franklin/housing-market"><b>Franklin housing market</b><small>Prices, days on market and supply.</small></a>
      <a href="/franklin/cost-of-living"><b>Cost of living</b><small>Income, rent and home value.</small></a>
      <a href="/franklin/buying-in-franklin"><b>Buying in Franklin</b><small>The steps from pre-approval to closing.</small></a>
    </div>
  </div></section>
  <GuideClose />
</GuideLayout>
