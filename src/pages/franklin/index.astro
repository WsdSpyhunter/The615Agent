---
import GuideLayout from '../../layouts/GuideLayout.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import { guidePages } from '../../data/franklin-guide';
import { M, usd, dateLong, signed } from '../../lib-guide';
const f = M.cities.franklin;
const live = guidePages.filter((p) => p.live);
const blurbs: Record<string, string> = { 'housing-market': 'Prices, days on market, supply, price per square foot and market temperature, with sources and dates.', 'home-prices': 'Three years of Franklin prices, price per square foot, a city-by-city table and a sample monthly payment.', 'property-taxes': 'The City of Franklin tax rate, how a Tennessee property tax bill is figured and a worked example.', 'schools': 'Which school districts serve Franklin and how to find the zoned school for an address.', 'commute': 'Census average commute time for Franklin and nearby cities.', 'cost-of-living': 'Census income, rent and home value for Franklin next to Redfin prices and the city tax rate.', 'selling-in-franklin': 'The steps to sell a home in Franklin, with today\'s local numbers.', 'franklin-vs-brentwood': 'Franklin and Brentwood side by side: prices, days on market, supply, income and commute.', 'franklin-vs-spring-hill': 'Franklin and Spring Hill side by side: prices, days on market, supply, income and commute.', 'franklin-vs-thompsons-station': 'Franklin and Thompson\'s Station side by side: prices, days on market, supply, income and commute.', 'new-construction': 'How much of Franklin\'s housing was built recently, next to nearby cities.', 'older-homes': 'How much of Franklin\'s housing is older, and what buyers commonly check.', 'luxury-homes': 'How many Franklin homes are valued at $1 million or more, from Census and Redfin.', 'neighborhoods': 'The three Franklin ZIP codes side by side, with Census numbers and no rankings.', 'buying-in-franklin': 'The steps to buy a home in Franklin, from pre-approval to closing, with today\'s local numbers.' };
---
<GuideLayout title="Franklin TN Real Estate Guide: Market, Prices and Moving" description={`A local guide to Franklin, Tennessee real estate by Scott Davis, REALTOR®: current market data (median price ${usd(f.medianPrice)}), prices and more, with sources and dates.`} h1={`Franklin, TN <em>real estate guide</em>`} lead="A local, data-backed guide to buying or selling a home in Franklin, Tennessee. Every number is sourced and dated, and it is updated automatically." updated={M.asOf}>
  <section class="s"><div class="wrap">
    <div class="sh"><div><span class="kicker navy">Start here</span><h2>Franklin at a glance</h2></div></div>
    <p class="answer">As of {dateLong(f.asOf)}, the median sale price in Franklin, Tennessee was {usd(f.medianPrice)} ({signed(f.yoy)} from a year earlier), with homes selling in a median of {f.dom} days (source: Redfin Data Center). Franklin is the Williamson County seat.</p>
    <div class="linkgrid">
      {live.map((p) => <a href={`/franklin/${p.slug}`}><b>{p.label}</b><small>{blurbs[p.slug]}</small></a>)}
    </div>
  </div></section>
  <section class="s band"><div class="wrap"><AuthorCard /></div></section>
</GuideLayout>
