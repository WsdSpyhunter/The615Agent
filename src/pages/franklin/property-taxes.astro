---
import GuideLayout from "../../layouts/GuideLayout.astro";
import ColorBar from "../../components/ColorBar.astro";
import GuideClose from "../../components/GuideClose.astro";
import { site } from "../../site.config";
import { M, C, usd, num, dateLong, monthShort, signed, censusRows, CITY_TAX_RATE } from "../../lib-guide";
const f = M.cities.franklin, cf = C.cities.franklin, when = dateLong(f.asOf);
const UPDATED = C.retrieved;
const acs = "U.S. Census Bureau, American Community Survey 5-Year Estimates (2020-2024)";
const faqSchema = (faq: any[]) => ({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((x) => ({ "@type": "Question", name: x.q, acceptedAnswer: { "@type": "Answer", text: x.a } })) });
const assessed = f.medianPrice * 0.25;
// Williamson County 2025 Property Tax Rates (Trustee), per $100 of assessed value
const R = { countyFssd: 1.18, fssd: 0.5873, countyNoFssd: 1.27, city: CITY_TAX_RATE };
const totFssd = R.countyFssd + R.fssd + R.city, totNo = R.countyNoFssd + R.city;
const bill = (rate: number) => (assessed * rate) / 100;
const r4 = (n: number) => '$' + n.toFixed(4);
const title = "Franklin TN Property Taxes: 2025 Rates and How Bills Work";
const description = `Franklin, TN property tax rates (2025): city $${CITY_TAX_RATE.toFixed(3)} per $100 of assessed value, plus county and school district rates, with a worked example. From the Williamson County Trustee.`;
const faq = [
  { q: "What is the property tax rate in Franklin, TN?", a: `For the 2025 tax year, Williamson County's rate sheet lists the City of Franklin at $${CITY_TAX_RATE.toFixed(3)} per $100 of assessed value, plus a county rate of $1.18 for addresses in the Franklin Special School District (which adds $0.5873 for the district) or $1.27 for Franklin addresses outside it. That is a combined ${r4(totFssd)} or ${r4(totNo)} per $100 of assessed value. Rates change each year, and the right figure depends on the exact address.` },
  { q: "How is a Tennessee property tax bill figured?", a: "The county assessor estimates the appraised value. Residential property is assessed at 25 percent of appraised value. The tax rate, set by local governments, is stated per $100 of assessed value. Tax equals assessed value divided by 100, multiplied by the rate." },
  { q: "Why are there two combined rates for Franklin?", a: "Some Franklin addresses are in the Franklin Special School District, which levies its own school tax, and others are not. The county's rate sheet lists the two cases separately, so check which applies to the address with the county." },
  { q: "Who sends the property tax bill?", a: "The County Trustee uses the tax rate and the assessor's tax roll to create and send tax bills and to collect county property taxes. The Property Assessor does not set the rate, send bills or collect taxes." },
  { q: "Will my property taxes change when I buy a home in Franklin?", a: "A bill is based on the property's appraised value, the assessment ratio and the current rates, not on the previous owner's bill. Taxes depend on the exact address, so verify them with the county for any home you are serious about." },
];
const schema = [faqSchema(faq)];
---
<GuideLayout title={title} description={description} h1={`Franklin, TN <em>property taxes</em>`} lead="The City of Franklin tax rate, how a Tennessee property tax bill is figured, and a worked example, with the official source next to every number." slug="property-taxes" label="Property taxes" updated={UPDATED} schema={schema}>
  <section class="s"><div class="wrap">
    <div class="sh"><div><span class="kicker navy">Official sources</span><h2>Franklin property taxes at a glance</h2></div></div>
    <p class="answer">For the 2025 tax year, the Williamson County Trustee's rate sheet lists the City of Franklin at ${CITY_TAX_RATE.toFixed(3)} per $100 of assessed value. A Franklin address in the Franklin Special School District pays a combined {r4(totFssd)} per $100 (county $1.18, school district $0.5873, city $0.296). A Franklin address outside that district pays a combined {r4(totNo)} (county $1.27 plus city $0.296). Rates change each year and the right one depends on the exact address.</p>
    <div class="stats">
      <div class="stat"><span>City of Franklin rate</span><b>${CITY_TAX_RATE.toFixed(3)}</b><small>per $100 assessed value</small></div>
      <div class="stat"><span>Combined, in FSSD area</span><b>{r4(totFssd)}</b><small>city + county + school district</small></div>
      <div class="stat"><span>Combined, outside FSSD</span><b>{r4(totNo)}</b><small>city + county</small></div>
    </div>
    <p class="sources" style="margin-top:12px">Sources: <a href="https://www.williamsoncounty-tn.gov/DocumentCenter/View/28580" rel="noopener" target="_blank">Williamson County 2025 Property Tax Rates</a> (county, school district and city rates); <a href="https://www.franklintn.gov/Home/Components/News/News/11755/83" rel="noopener" target="_blank">City of Franklin 2026-2027 budget</a> (the proposed rate is unchanged at $0.296); <a href="https://comptroller.tn.gov/office-functions/pa/property-taxes/how-to-figure-your-tax-bill.html" rel="noopener" target="_blank">Tennessee Comptroller, how to figure your tax bill</a>. The combined figures are my addition of the rates on the county sheet. The 2025 sheet is the most recent I found, and 2026 rates may differ.</p>
  </div></section>
  <ColorBar rev />
  <section class="s band"><div class="wrap prose">
    <div class="sh"><div><span class="kicker navy">How it works</span><h2>How a Franklin property tax bill is figured</h2></div></div>
    <ol>
      <li><b>Appraised value.</b> The Williamson County Property Assessor estimates the value of each property.</li>
      <li><b>Assessed value.</b> Residential property is assessed at 25 percent of its appraised value.</li>
      <li><b>Rate.</b> Rates are stated per $100 of assessed value and are set each year by the county, the city and, where it applies, the Franklin Special School District.</li>
      <li><b>Bill.</b> Tax equals assessed value divided by 100, multiplied by the rate. The County Trustee sends the bills.</li>
    </ol>
    <h3>A worked example</h3>
    <p>This is an illustration, not a prediction for any home. If a Franklin home were appraised at {usd(f.medianPrice)} (Redfin's median sale price as of {when}), its assessed value would be {usd(assessed)}. At the 2025 rates on the county's sheet, the yearly bill would be about:</p>
    <div class="tablewrap"><table class="data"><caption>Illustration only, 2025 rates per $100 of assessed value</caption>
      <thead><tr><th>Franklin address</th><th>Combined rate</th><th>About per year</th></tr></thead>
      <tbody>
        <tr><td>In the Franklin Special School District</td><td>{r4(totFssd)}</td><td>{usd(bill(totFssd))}</td></tr>
        <tr><td>Outside the district</td><td>{r4(totNo)}</td><td>{usd(bill(totNo))}</td></tr>
      </tbody></table></div>
    <p class="sources">An appraisal can differ from a sale price, and property taxes depend on the exact address, so verify them with the county for any home you are serious about. Rates can change when governments adopt new budgets or after a reappraisal. This page is not tax advice.</p>
  </div></section>
  <section class="s"><div class="wrap">
    <div class="sh"><div><span class="kicker navy">Common questions</span><h2>Franklin property tax FAQ</h2></div></div>
    <div class="faq">{faq.map((x, i) => <details open={i === 0}><summary>{x.q}</summary><p>{x.a}</p></details>)}</div>
    <p class="sources" style="margin-top:14px">This page is general information, not legal, tax, lending or financial advice. Ask a tax professional about your situation. Equal Housing Opportunity.</p>
    <div class="linkgrid" style="margin-top:18px">
      <a href="/franklin/cost-of-living"><b>Cost of living</b><small>Income, rent and home value.</small></a>
      <a href="/franklin/home-prices"><b>Franklin home prices</b><small>Three years of prices and a sample payment.</small></a>
      <a href="/franklin/buying-in-franklin"><b>Buying in Franklin</b><small>The steps from pre-approval to closing.</small></a>
    </div>
  </div></section>
  <GuideClose />
</GuideLayout>
