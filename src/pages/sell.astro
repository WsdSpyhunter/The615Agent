---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import LeadForm from '../components/LeadForm.astro';
import ColorBar from '../components/ColorBar.astro';
import { site } from '../site.config';
---
<Layout title="What's My Home Worth? Home Value in Williamson County and Middle TN" description="Share your address and a few details and Scott Davis will follow up with a local, real-world price opinion for your Williamson County or Middle Tennessee home.">
  <PageHeader eyebrow="Sellers" title="What's my home <em>worth?</em>" lead="Share your address and a few details. I'll follow up with a local, real-world price opinion." />
  <section class="s" id="form"><div class="wrap contact">
    <div class="info">
      <span class="kicker">How it works</span>
      <h2 class="h2">A real opinion, not a guess</h2>
      <p style="color:var(--muted)">Online estimates can miss what makes your home different. I look at recent local sales, your home's condition and your timeline, then give you my honest price opinion.</p>
      <p class="hint">Prefer to talk now? Call or text <a href={`tel:${site.phoneHref}`} style="text-decoration:underline">{site.phone}</a>.</p>
    </div>
    <LeadForm type="seller" id="seller-form" />
  </div></section>
  <ColorBar rev />
  <section class="s band"><div class="wrap">
    <div class="sh"><div><span class="kicker navy">Seller guides</span><h2>Helpful tools for sellers</h2></div></div>
    <div class="cardgrid">
      <a class="card t1" href="/checklists"><h3>Seller's moving checklist</h3><p>From your first conversation to your last box out the door. View online or download the PDF.</p></a>
      <a class="card t2" href="/market-data"><h3>Market data</h3><p>See how the market is moving in your city.</p></a>
      <a class="card t3" href="/mortgage-calculator"><h3>Mortgage calculator</h3><p>Help your buyers and yourself plan the next purchase.</p></a>
      <a class="card t4" href="/resources"><h3>Local resources</h3><p>County property records, tax information and more.</p></a>
      <a class="card t1" href="/blog"><h3>The blog</h3><p>Tips for preparing, pricing and selling your home.</p></a>
      <a class="card t2" href="/contact"><h3>Talk it through</h3><p>Questions before you list? Send me a note.</p></a>
    </div>
  </div></section>
</Layout>
