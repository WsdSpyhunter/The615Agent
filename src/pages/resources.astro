---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ColorBar from '../components/ColorBar.astro';
import resources from '../data/resources.json';
---
<Layout title="Resources for Buyers, Sellers, Relocators and Investors" description="Helpful links for Williamson County and Middle Tennessee: property records, school districts, utilities, lender programs, and city services.">
  <PageHeader eyebrow="Resources" title="Helpful links for your <em>move</em>" lead="Official and trusted sources for property records, schools, utilities, financing programs and local services." />
  <section class="s"><div class="wrap">
    <div class="cta-band" style="margin-bottom:40px">
      <div><h2>Free moving checklists</h2><p>Buyer and seller checklists you can view online or download.</p></div>
      <a class="btn gold" href="/checklists">Open the checklists</a>
    </div>
    {resources.map((g) => (
      <div class="resgroup" id={g.id}>
        <h2>{g.title}</h2>
        <ul class="reslist">
          {g.links.map((l) => <li><a href={l.url} target="_blank" rel="noopener"><b>{l.name} ↗</b><small>{l.note}</small></a></li>)}
        </ul>
      </div>
    ))}
    <div class="resgroup" id="insurance">
      <h2>Home insurance</h2>
      <div class="insbox">
        <h3>Steve Emley, Emley Risk Management</h3>
        <p>Steve is a trusted insurance broker that I often refer clients to. I receive no payment or any type of compensation for referring him to clients. You’re free to use any insurance agent, and I always suggest getting quotes from more than one insurance agent.</p>
        <p class="inslinks"><a href="https://www.emleyrm.com/" target="_blank" rel="noopener">emleyrm.com ↗</a> · <a href="mailto:steve@emleyrm.com">steve@emleyrm.com</a> · <a href="tel:+16153920833">(615) 392-0833</a></p>
      </div>
    </div>
    <p class="hint">Links open official third-party sites. Always verify details for your specific property and situation.</p>
  </div></section>
</Layout>
<style>
  .insbox{background:#fff;border:1.5px solid var(--blue);border-radius:16px;padding:22px 24px;max-width:760px}
  .insbox h3{font-size:1.25rem;margin-bottom:8px}
  .insbox p{margin:0 0 10px;line-height:1.7}
  .inslinks{font-weight:700}
  .inslinks a{color:var(--navy-text);text-decoration:underline}
</style>
