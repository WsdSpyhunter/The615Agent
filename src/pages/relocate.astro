<script>
  // The payment table recalculates as the visitor types. Same loan in every tax area; only the property tax differs.
  const root = document.getElementById('paytool');
  if (root) {
    const rates: Record<string, number> = Object.fromEntries((JSON.parse(root.dataset.areas || '[]') as { key: string; rate: number }[]).map((a) => [a.key, a.rate]));
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    const num = (el: HTMLInputElement) => parseFloat(el.value.replace(/[^0-9.]/g, ''));
    const run = () => {
      const price = Math.min(5000000, Math.max(50000, num($('pt-price')) || 0)), down = Math.min(90, Math.max(0, num($('pt-down')) || 0)), rate = Math.min(15, Math.max(0, num($('pt-rate')) || 0));
      const loan = price * (1 - down / 100), r = rate / 100 / 12, pi = r === 0 ? loan / 360 : (loan * r) / (1 - Math.pow(1 + r, -360));
      $('pt-loan').textContent = usd(loan); $('pt-pi').textContent = usd(pi);
      root.querySelectorAll<HTMLElement>('tbody tr').forEach((tr) => {
        const tax = (price * 0.25 * rates[tr.dataset.key || '']) / 100 / 12;
        tr.querySelector('.pt-tax')!.textContent = usd(tax); tr.querySelector('.pt-tot')!.textContent = usd(pi + tax);
      });
    };
    ['pt-price', 'pt-down', 'pt-rate'].forEach((id) => $(id).addEventListener('input', run));
    $('pt-price').addEventListener('blur', () => { const v = num($('pt-price')); if (v) $('pt-price').value = Math.round(v).toLocaleString('en-US'); });
  }
</script>
