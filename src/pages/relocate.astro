---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ColorBar from '../components/ColorBar.astro';
import AuthorCard from '../components/AuthorCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../site.config';
import { M, C, usd, dateLong } from '../lib-guide';
import { guideCities, cityNames } from '../data/guide-cities';
import taxRates from '../../public/data/property-tax-rates.json';
import checklist from '../../public/data/relocation-checklist.json';
import weekly from '../../public/data/market-weekly.json';
import extra from '../../public/data/relocate-extra.json';

// Everything in the city table comes from the same files the city guides use, so the page never disagrees with them.
const rate = Object.fromEntries(taxRates.areas.map((a: any) => [a.key, a.rate]));
const APPRAISED = 500000;
const perYear = (r: number) => Math.round((APPRAISED * 0.25 * r) / 100);
const taxKeys: Record<string, string[]> = {
  franklin: ['franklin', 'franklin-outside-fssd'],
  brentwood: ['brentwood'],
  'spring-hill': ['spring-hill-williamson', 'spring-hill-maury'],
  'thompsons-station': ['thompsons-station'],
  nolensville: ['nolensville'],
  columbia: ['columbia'],
  murfreesboro: ['murfreesboro'],
  nashville: ['nashville', 'davidson-gsd'],
};
const taxText = (slug: string) => {
  const v = taxKeys[slug].map((k) => perYear(rate[k])).sort((a, b) => a - b);
  return v[0] === v[v.length - 1] ? `about ${usd(v[0])}` : `about ${usd(v[0])} to ${usd(v[v.length - 1])}`;
};
// Twelve places side by side. Eight are full city guides; four are extras for this table only (they are not in the market temperature gauge).
// Bellevue and Donelson are Nashville neighborhoods (Redfin neighborhood data, Census figures for their ZIP codes). Mt. Juliet and Smyrna come from Redfin's city data.
const zipRange = (zs: string[]) => {
  const v = zs.map((z) => C.zips[z]?.meanCommuteMinutes).filter((x) => x != null) as number[];
  if (!v.length) return '';
  const lo = Math.min(...v), hi = Math.max(...v);
  return lo === hi ? `${lo} min` : `${lo} to ${hi} min`;
};
const NOT_VERIFIED = 'Not yet verified';
type Row = { slug?: string; name: string; note?: string; price: number | null; supply: number | null; tax: string; commute: string; zips: string[]; zipLink?: string };
const cityRows: Row[] = Object.keys(cityNames).map((s) => ({ slug: s, name: cityNames[s], price: M.cities[s].medianPrice, supply: M.cities[s].monthsSupply, commute: `${C.cities[s].meanCommuteMinutes} min`, zips: guideCities[s].zips, tax: taxText(s), zipLink: guideCities[s].zips.length > 6 ? `/${s}/neighborhoods/` : undefined }));
const extraRows: Row[] = [
  { name: 'Bellevue', note: 'Nashville neighborhood', price: M.cities['bellevue'].medianPrice, supply: M.cities['bellevue'].monthsSupply, tax: taxText('nashville'), commute: zipRange(['37221']), zips: ['37221'] },
  { name: 'Donelson', note: 'Nashville neighborhood, with Hermitage', price: M.cities['donelson-hermitage'].medianPrice, supply: M.cities['donelson-hermitage'].monthsSupply, tax: taxText('nashville'), commute: zipRange(['37214', '37076']), zips: ['37214', '37076'] },
  ...Object.entries(extra.cities).map(([k, v]: [string, any]) => ({ name: v.name, note: `${v.county} County`, price: v.redfin?.medianPrice ?? null, supply: v.redfin?.monthsSupply ?? null, tax: NOT_VERIFIED, commute: v.commute != null ? `${v.commute} min` : 'Not yet added', zips: v.zips })),
];
const rows: Row[] = [...cityRows, ...extraRows].sort((a, b) => a.name.localeCompare(b.name));
const reloPosts = (await getCollection('posts', (p) => !p.data.draft && p.data.category === 'Relocation')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const dateOf = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const allTax = taxRates.areas.map((a: any) => perYear(a.rate)).sort((a: number, b: number) => a - b);
const asOf = dateLong(M.asOf ?? M.cities.franklin.asOf);

// Payment-by-area tool: the same loan in every tax area, so only the property tax changes. Rows and rates come from the property tax data file.
const payAreas = [
  { key: 'franklin', label: 'Franklin, inside the Franklin Special School District', county: 'Williamson', from: '2026' },
  { key: 'franklin-outside-fssd', label: 'Franklin, outside that school district', county: 'Williamson', from: '2026' },
  { key: 'brentwood', label: 'Brentwood', county: 'Williamson', from: '2026' },
  { key: 'nolensville', label: 'Nolensville', county: 'Williamson', from: '2026' },
  { key: 'thompsons-station', label: "Thompson's Station", county: 'Williamson', from: '2026' },
  { key: 'spring-hill-williamson', label: 'Spring Hill, Williamson County side', county: 'Williamson', from: '2026' },
  { key: 'nashville', label: 'Nashville, Urban Services District', county: 'Davidson', from: '2025, held flat for 2026-27' },
  { key: 'davidson-gsd', label: 'Davidson County outside the Urban Services District', county: 'Davidson', from: '2025, held flat for 2026-27' },
  { key: 'murfreesboro', label: 'Murfreesboro', county: 'Rutherford', from: '2026' },
  { key: 'columbia', label: 'Columbia', county: 'Maury', from: '2025 (2026 may be lower)' },
  { key: 'spring-hill-maury', label: 'Spring Hill, Maury County side', county: 'Maury', from: '2025 (2026 may be lower)' },
].map((a) => ({ ...a, rate: rate[a.key] as number }));
const PAY = { price: 600000, down: 20, rate: Number(M.mortgageRate30) };
const loanPay = (price: number, downPct: number, ratePct: number) => {
  const loan = price * (1 - downPct / 100), r = ratePct / 100 / 12, n = 360;
  return { loan, pi: r === 0 ? loan / n : (loan * r) / (1 - Math.pow(1 + r, -n)) };
};
const taxMo = (price: number, r: number) => (price * 0.25 * r) / 100 / 12;
const startPay = loanPay(PAY.price, PAY.down, PAY.rate);
const usd0 = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const W = weekly.latest;
const wkEnd = dateLong(W.periodEnd);

const steps = [
  { n: 1, when: '6-12 months out', t: 'Decide why, and set a date', d: 'Write down what is driving the move and when you would like to be settled. A target date makes every later step easier to place.', links: [['Buyer and seller checklists', '/checklists/']] },
  { n: 2, when: '4-6 months out', t: 'Set a budget you trust', d: 'Talk to a lender and get pre-approved. Then see what a payment looks like with each area\'s real property tax, not a guess.', links: [['Mortgage calculator', '/mortgage-calculator/'], ['Property tax rates compared', '/property-taxes/']] },
  { n: 3, when: '3-4 months out', t: 'Compare areas by the numbers', d: 'Use the table below to line up price, supply, tax and commute, then open the guide for any city you want to look at more closely.', links: [['Compare cities', '#compare']] },
  { n: 4, when: '2-3 months out', t: 'Check the exact address', d: 'School assignment, property tax and commute all depend on the exact address. Verify each one for any home you are serious about.', links: [['How to check schools', '/franklin/schools/'], ['Tax relief and appeals', '/property-taxes/relief-and-appeals/']] },
  { n: 5, when: '1-3 months out', t: 'Visit, and make an offer', d: 'Visit in person if you can, and drive the commute at the time you would drive it. If you are buying from far away, the out-of-state guide walks through how it works.', links: [['Buying from out of state', '/blog/buying-a-home-from-out-of-state/']] },
  { n: 6, when: '4-8 weeks out', t: 'Close, and book the move', d: 'Line up the closing date, the movers and the utilities. If you own a home now, talk to an agent licensed in that state about timing both closings.', links: [['Moving checklist', '#checklist']] },
  { n: 7, when: 'First 30 days', t: 'Settle in', d: 'Get your Tennessee license, register your vehicle and update your address. The state sets the rules, so the next section links to each official page.', links: [['Tennessee basics', '#basics']] },
];

type QA = { q: string; a: string; links?: string[][] };
const topQ: QA[] = [
  { q: 'Which areas fit my lifestyle and budget?', a: 'I cannot pick an area for you, and fair housing law protects your right to choose where you live. What I can do is help you narrow it down with things you can measure. Start with the table above: price, supply, property tax and commute for each city. Then choose two or three areas to visit at different times of day, and look at specific homes. Tell me your budget, where you commute to and what you want in a home, and I will show you homes that match what you listed.', links: [['Compare the cities', '#compare'], ['Get matched with homes', '/buy#form']] },
  { q: 'How do school zones work, and how do I check them?', a: 'Which school a home is zoned for depends on the exact address, and districts can change their boundaries, so check the zoned schools for a specific address with the school district, even if you do not have children. I do not rate or rank schools. The state publishes official school data in its report card. Each city guide has a short checklist for checking schools at an address.', links: [['Franklin schools', '/franklin/schools/'], ['Spring Hill schools', '/spring-hill/schools/'], ['Nashville schools', '/nashville/schools/']] },
  { q: 'What is the commute really like at rush hour?', a: 'The Census figure in the table is the average one-way commute for the whole city, so use it as a starting point. Your own commute depends on where you work. Test the drive at the time you would actually drive it, using a maps app set to that departure time, and ask about construction. The Tennessee Department of Transportation publishes information on state road projects.', links: [['Franklin commute', '/franklin/commute/'], ['TDOT projects', 'https://www.tn.gov/tdot/projects.html']] },
  { q: 'What is the market like right now?', a: `As of the four weeks ending ${wkEnd}, Redfin's Nashville metro figures show a median sale price of ${usd0(W.medianPrice)}, ${W.monthsSupply} months of supply, ${W.dom} days on market and homes selling at ${W.saleToList}% of list price. Months of supply is how long current inventory would take to sell at the current pace, and roughly 4 to 6 months is commonly treated as balanced. Each city differs, so see the market temperature and the housing market page for the city you are looking at.`, links: [['Market data', '/market-data/']] },
  { q: 'What will it really cost to live and own a home here?', a: `Property tax is the clearest difference between areas. On a home appraised at $500,000, the yearly tax across the areas I cover runs from ${usd(allTax[0])} to ${usd(allTax[allTax.length - 1])} at the latest published rates. Insurance, HOA dues and utilities depend on the specific home, so get quotes for the address you are considering. The payment tool above and the mortgage calculator add the pieces together.`, links: [['Property tax rates compared', '/property-taxes/'], ['Mortgage calculator', '/mortgage-calculator/']] },
  { q: 'How much can I comfortably afford?', a: 'Build your budget as a monthly payment, not just a price: the loan payment, property tax, insurance, mortgage insurance if it applies, and HOA dues. Talk to a lender early and get pre-approved so you know your real number. Closing costs typically run 2 to 4 percent of the purchase price, plus earnest money and moving costs. I am not a lender, so treat any figures here as estimates.', links: [['Mortgage calculator', '/mortgage-calculator/']] },
  { q: 'How does the local buying process work?', a: 'Every state does it a little differently. In Tennessee, closings are commonly handled by a title company or an attorney, and your lender\'s Loan Estimate itemizes the closing costs, including state and local recording fees and taxes. Before you make an offer, ask your agent to walk you through the contract, the inspection period and its deadlines, and who holds your earnest money.', links: [['Buyer checklist', '/checklists/']] },
  { q: 'Can I buy from out of state, or should I rent first?', a: 'Yes, you can buy from out of state. Many buyers tour by live video, hire a local inspector and sign electronically, and some visit once before they close. Renting for a few months first is a reasonable choice if you want more time to explore, and it is your call.', links: [['Buying from out of state', '/blog/buying-a-home-from-out-of-state/']] },
  { q: 'What if my timing does not line up?', a: 'Selling, starting a job and buying rarely happen on the same day. Options people ask about include a contingency to sell first, a bridge loan, a rent-back (the seller stays in the home for an agreed time after closing) and short-term housing. Availability and terms vary, so talk to your lender and to an agent in the state where you are selling. My license covers Tennessee, so I can plan the Tennessee side with you.', links: [['Relocation checklist', '#checklist']] },
  { q: 'What is changing in the area, and who can I trust locally?', a: 'Planned roads and developments are public information. The Tennessee Department of Transportation publishes state road projects, and city and county planning departments publish proposed developments. Nobody can tell you how a project will affect a home\'s value, so I do not predict it. For a specific address, ask what is planned nearby and check the public records. When you are new, ask your agent for two or three names in each category, such as lenders, inspectors and movers, and check licenses and reviews yourself.', links: [['TDOT projects', 'https://www.tn.gov/tdot/projects.html']] },
];
const tnQ: QA[] = [
  { q: 'Does Tennessee have a state income tax?', a: 'Tennessee does not tax wages and salaries. The Hall income tax, which applied only to interest and dividends, was repealed for tax periods beginning January 1, 2021 or later, according to the Tennessee Department of Revenue. Tax rules for your situation can still depend on where you work and live, so ask a tax professional.' },
  { q: 'How soon do I need a Tennessee driver license?', a: 'The Tennessee Department of Safety says new residents with a license from another state must get a Tennessee license no later than 30 days after establishing residency, at a full-service Driver Services Center. Residents coming from certain states must also bring a certified driving record, so check the state\'s current notice before you go.' },
  { q: 'How do I register my car in Tennessee?', a: 'The Tennessee Department of Revenue says someone moving from another state files an application for title and registration through their local county clerk, and brings their most current out-of-state registration. The state\'s page lists the documents.' },
];
const faq = [...topQ, ...tnQ];
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Moving to Middle Tennessee', url: `${site.url}/relocate/`, about: 'Steps, costs and a checklist for relocating to Franklin, Brentwood, Spring Hill, Thompson\'s Station, Nolensville, Columbia, Murfreesboro and Nashville, Tennessee' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })) },
];
---
<Layout title="Moving to Middle Tennessee: Steps, Costs and a Free Checklist" description="Relocating to Franklin, Brentwood, Spring Hill, Nashville or nearby? A 7-step plan, twelve areas side by side with sourced numbers, Tennessee basics and a free checklist." schema={schema} image="/img/skyline-night-1600.jpg">
  <PageHeader eyebrow="Relocating" title="Moving to <em>Middle Tennessee</em>" lead="A plain 7-step plan, twelve areas side by side with sourced numbers, the Tennessee basics and a free checklist. No rankings, no pressure." />

  <section class="s" id="start"><div class="wrap">
    <div class="sh center"><div><span class="kicker navy">Start here</span><h2>Where are you in the relocation process?</h2></div></div>
    <div class="paths relo-paths">
      <a class="path p-gold" href="#steps"><h3>Just exploring</h3><p>See the whole move in seven steps and what comes first.</p><span class="more">See the 7 steps →</span></a>
      <a class="path p-coral" href="#compare"><h3>Choosing a city</h3><p>Twelve areas side by side: price, supply, tax and commute.</p><span class="more">Compare the cities →</span></a>
      <a class="path p-blue" href="/buy#form"><h3>Ready to buy</h3><p>Tell me your budget, area and timeline, and we'll talk within 48 hours.</p><span class="more">Get matched with homes →</span></a>
    </div>
  </div></section>
  <ColorBar rev />

  <section class="s band" id="steps"><div class="wrap">
    <div class="sh center"><div><span class="kicker navy">Your move</span><h2>The move in 7 steps</h2><p>Timing is a general guide. Your own dates will shift it.</p></div></div>
    <ol class="relo-steps">
      {steps.map((s) => (
        <li>
          <span class="relo-n">{s.n}</span>
          <div class="relo-body">
            <span class="relo-when">{s.when}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <p class="relo-links">{s.links.map(([label, href], k) => <><a href={href}>{label}</a>{k < s.links.length - 1 ? ' · ' : ''}</>)}</p>
          </div>
        </li>
      ))}
    </ol>
  </div></section>
  <ColorBar />

  <section class="s" id="compare"><div class="wrap">
    <div class="sh center"><div><span class="kicker navy">Twelve areas side by side</span><h2>Compare the numbers</h2></div></div>
    <p class="answer" style="max-width:68ch;margin:0 auto 22px;text-align:center">Listed alphabetically, not ranked. Open any city for its full guide.</p>
    <div class="relowrap"><table class="relotable"><caption>Redfin median sale price and months of supply as of {asOf}; Census average commute; property tax on a {usd(APPRAISED)} home</caption>
      <thead><tr><th>City</th><th>Median sale price</th><th>Months of supply</th><th>Yearly property tax on a {usd(APPRAISED)} home</th><th>Average commute</th><th>ZIP codes</th></tr></thead>
      <tbody>{rows.map((r) => <tr><td>{r.slug ? <a href={`/${r.slug}/`}>{r.name}</a> : <b>{r.name}</b>}{r.note && <small class="paycounty"> · {r.note}</small>}</td><td>{r.price != null ? usd(r.price) : 'n/a'}</td><td>{r.supply ?? 'n/a'}</td><td>{r.tax}</td><td>{r.commute || 'n/a'}</td><td>{r.zipLink ? <a href={r.zipLink}>{r.zips.length} ZIP codes</a> : r.zips.join(', ')}</td></tr>)}</tbody></table></div>
    <p class="hint" style="margin-top:12px;text-align:center">Where a row shows a range, the tax depends on the school district, county side or service district the home is in. Tax rates are the latest published and are shown with their rate year and source on the <a href="/property-taxes/">property tax page</a>. Commute is the Census Bureau's average for the whole city. For Bellevue and Donelson, which are Nashville neighborhoods, price and supply are Redfin's neighborhood figures, commute is the Census figure for their ZIP codes, and the tax range is Nashville's (Davidson County's two service districts). Mt. Juliet and Smyrna show Redfin's citywide figures. I have not yet confirmed an official 2026 property tax rate for either, so no figure is shown; check with the county trustee and the city. City names that are links open a full city guide. These are illustrations, not a quote for any home.</p>
  </div></section>
  <ColorBar rev />

  <section class="s band" id="payment"><div class="wrap">
    <div class="sh center"><div><span class="kicker navy">Know your payment</span><h2>Same home price, different property tax</h2><p>Enter a price once and see the monthly payment in every tax area. The loan payment is identical everywhere, so the only difference is the property tax.</p></div></div>
    <div class="paytool" id="paytool" data-areas={JSON.stringify(payAreas.map((a) => ({ key: a.key, rate: a.rate })))}>
      <div class="payin">
        <label>Home price<input id="pt-price" inputmode="numeric" autocomplete="off" value={PAY.price.toLocaleString('en-US')} /></label>
        <label>Down payment (%)<input id="pt-down" inputmode="decimal" autocomplete="off" value={String(PAY.down)} /></label>
        <label>Interest rate (%)<input id="pt-rate" inputmode="decimal" autocomplete="off" value={String(PAY.rate)} /></label>
      </div>
      <p class="payloan">Loan payment, principal and interest, on a 30-year fixed loan of <b id="pt-loan">{usd0(startPay.loan)}</b>: <b id="pt-pi">{usd0(startPay.pi)}</b> a month</p>
      <div class="relowrap"><table class="relotable"><caption>Monthly property tax and total with the loan payment, by tax area</caption>
        <thead><tr><th>Tax area</th><th>Rate year</th><th>Property tax per month</th><th>Monthly total before insurance</th></tr></thead>
        <tbody>{payAreas.map((a) => <tr data-key={a.key}><td>{a.label}<small class="paycounty"> · {a.county} County</small></td><td>{a.from}</td><td class="pt-tax">{usd0(taxMo(PAY.price, a.rate))}</td><td class="pt-tot">{usd0(startPay.pi + taxMo(PAY.price, a.rate))}</td></tr>)}</tbody></table></div>
      <p class="hint" style="margin-top:12px;text-align:center">Illustration, not a loan offer or quote. It assumes the home's appraised value equals the price you enter, a 30-year fixed loan, and no mortgage insurance. It leaves out home insurance, HOA dues and utilities. The starting rate is Freddie Mac's weekly average 30-year fixed rate as of {dateLong(M.mortgageRateAsOf)} (via the Federal Reserve Bank of St. Louis), an average and not a quote. Listed by county, not ranked. Tax rates and sources are on the <a href="/property-taxes/">property tax page</a>. Maury County is in a 2026 reappraisal year, so its 2026 rate may be lower.</p>
    </div>
    <div class="relo-card" style="margin-top:28px">
      <span class="relo-logo"><img src="/img/logo-615-agent.webp" alt="The 615 Agent" width="648" height="329" loading="lazy" decoding="async" /></span>
      <p>Want to add insurance, mortgage insurance and HOA dues, or try FHA and VA loans? The mortgage calculator does that, with each area's property tax filled in.</p>
      <a class="btn primary" href="/mortgage-calculator/">Open the mortgage calculator</a>
    </div>
  </div></section>
  <ColorBar />

  <section class="s" id="basics"><div class="wrap prose" style="max-width:820px;margin-inline:auto">
    <div class="relo-box">
    <div class="sh center"><div><span class="kicker navy">Tennessee basics</span><h2>What to know before you arrive</h2><p>Each item links to the state's own page. Rules and fees change, so confirm before you go.</p></div></div>
    <ul class="relo-basics">
      <li><b>Income tax.</b> Tennessee does not tax wages and salaries. The Hall income tax on interest and dividends was repealed for tax periods beginning January 1, 2021 or later. <a href="https://www.tn.gov/revenue/taxes/hall-income-tax.html" rel="noopener" target="_blank">Tennessee Department of Revenue</a>. Ask a tax professional how this applies to you.</li>
      <li><b>Property tax.</b> Residential property is assessed at 25 percent of its appraised value, then taxed at the county, city and sometimes school district rate. See <a href="/property-taxes/">rates compared</a> and <a href="/property-taxes/relief-and-appeals/">relief and appeals</a>.</li>
      <li><b>Driver license.</b> A new resident with an out-of-state license must get a Tennessee license no later than 30 days after establishing residency, at a full-service Driver Services Center. Some states also require a certified driving record. <a href="https://www.tn.gov/safety/driver-services/classd/dlnew.html" rel="noopener" target="_blank">Tennessee Department of Safety, new residents</a>.</li>
      <li><b>Vehicle registration.</b> Someone moving from another state files an application for title and registration through their local county clerk, and brings their most current out-of-state registration. <a href="https://www.tn.gov/revenue/title-and-registration/vehicle-registration/registration-new.html" rel="noopener" target="_blank">Tennessee Department of Revenue, initial registration</a>.</li>
      <li><b>Utilities and local services.</b> Electric, water, gas and internet providers depend on the exact address. <a href="/resources/">My resources page</a> lists the main ones.</li>
    </ul>
    </div>
  </div></section>
  <ColorBar rev />

  <section class="s band" id="checklist"><div class="wrap narrow2">
    <div class="sh center"><div><span class="kicker navy">Free checklist</span><h2>Your relocation checklist</h2><p>Check items off as you go. Your progress is saved on this device, and nothing is sent to anyone.</p></div></div>
    <tpa-checklist id="clreloc" src="/data/relocation-checklist.json" storage-key="clreloc" tabs="false">
      {Object.values(checklist).map((steps: any) => <section>{steps.map((s: any) => <div><h4>{s.title} ({s.when})</h4><ul>{s.items.map((i: string) => <li>{i}</li>)}</ul></div>)}</section>)}
    </tpa-checklist>
    <p class="hint" style="margin-top:14px">Want the buyer or seller checklist too? See <a href="/checklists/">all checklists</a>.</p>
  </div></section>
  <ColorBar />

  <section class="s" id="faq"><div class="wrap prose" style="max-width:820px;margin-inline:auto">
    <div class="sh center"><div><span class="kicker navy">Common questions</span><h2>The top 10 questions relocators ask</h2></div></div>
    <div class="faq">{topQ.map((x, i) => <details class={`tone t${i % 4}`} open={i === 0}><summary>{x.q}</summary><p>{x.a}</p>{x.links && <p class="relo-links">{x.links.map(([label, href], k) => <><a href={href} rel={href.startsWith('http') ? 'noopener' : undefined} target={href.startsWith('http') ? '_blank' : undefined}>{label}</a>{k < x.links.length - 1 ? ' · ' : ''}</>)}</p>}</details>)}</div>
    <div class="sh center" style="margin-top:36px"><div><h3>Tennessee quick answers</h3></div></div>
    <div class="faq">{tnQ.map((x, i) => <details class={`tone t${(i + 2) % 4}`}><summary>{x.q}</summary><p>{x.a}</p></details>)}</div>
    <p class="hint" style="margin-top:16px;text-align:center">This page is general information, not legal, tax, lending or financial advice. I do not rank cities or steer buyers toward or away from any area. Equal Housing Opportunity.</p>
    <div class="relo-card relo-ask" style="margin-top:24px"><p>Thinking about a move? I'm happy to answer questions about the area and help you figure out where to start.</p><a class="btn primary" href="/contact">Ask me a question</a></div>
  </div></section>
  {reloPosts.length > 0 && <section class="s band" id="relo-blog"><div class="wrap">
    <div class="sh center"><div><span class="kicker navy">From the blog</span><h2>More on relocating</h2></div></div>
    <div class="relo-posts">{reloPosts.map((p) => <a href={`/blog/${p.id}`}><b>{p.data.title}</b><small>{p.data.category} · {dateOf(p.data.pubDate)}</small></a>)}</div>
  </div></section>}

  <section class="s"><div class="wrap">
    <AuthorCard />
    <div class="cta-band relo-cta">
      <div><h2 style="font-size:1.3rem">Planning a move to Middle Tennessee?</h2><p>Tell me your budget, area and timeline, and we'll be talking within the next 48 hours.</p></div>
      <div class="relo-cta-btns"><a class="btn gold" href="/buy#form">Get Matched With Homes</a><a class="btn ghost" href="/contact" style="color:#fff">Plan your move with me</a></div>
    </div>
  </div></section>
</Layout>
